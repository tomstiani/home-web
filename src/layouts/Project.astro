---
import Base from './Base.astro'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  description: string
  date: Date
  tags: string[]
  status: 'completed' | 'ongoing'
  cover?: ImageMetadata
  github?: string
}

const { title, description, date, tags, status, cover, github } = Astro.props

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<Base title={title} description={description}>
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-24">

    <!-- Back link -->
    <a
      href="/projects"
      class="inline-flex items-center min-h-[44px] gap-2 text-sm mb-10 text-muted transition-colors duration-150 hover:text-heading"
    >
      &larr; Projects
    </a>

    <!-- Cover image -->
    {cover && (
      <Image
        src={cover}
        alt={title}
        width={900}
        height={256}
        class="w-full h-64 object-cover rounded-lg mb-10 border border-border"
      />
    )}

    <!-- Header -->
    <header class="mb-10">
      <h1 class="text-4xl font-semibold tracking-tight leading-tight mb-4 text-heading">
        {title}
      </h1>
      <p class="text-lg mb-6 text-muted">{description}</p>

      <!-- Meta bar -->
      <div class="flex flex-wrap items-center gap-4 pt-5 border-t border-border">
        <span class="text-sm text-muted">{formattedDate}</span>

        {status === 'ongoing' && (
          <span class="flex items-center gap-1.5 text-xs font-medium text-accent">
            <span class="w-1.5 h-1.5 rounded-full inline-block bg-accent"></span>
            Ongoing
          </span>
        )}

        <div class="flex flex-wrap gap-1.5">
          {tags.map(tag => (
            <span class="text-xs px-2 py-0.5 rounded-full font-mono bg-accent-dim text-accent border border-accent-dim2">
              {tag}
            </span>
          ))}
        </div>

        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-muted transition-colors duration-150 hover:text-heading ml-auto"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>
            </svg>
            GitHub
          </a>
        )}
      </div>
    </header>

    <!-- MDX content -->
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
