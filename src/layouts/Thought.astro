---
import Base from './Base.astro'

interface Props {
  title: string
  description: string
  date: Date
  tags: string[]
  published: boolean
}

const { title, description, date, tags, published } = Astro.props

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<Base title={title} description={description} noindex={!published}>
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-24">

    <!-- Back link -->
    <a
      href="/thoughts"
      class="inline-flex items-center min-h-[44px] gap-2 text-sm mb-10 text-muted transition-colors duration-150 hover:text-heading"
    >
      &larr; Thoughts
    </a>

    <!-- Header -->
    <header class="mb-10">
      <h1 class="text-4xl font-semibold tracking-tight leading-tight mb-4 text-heading">
        {title}
      </h1>
      <p class="text-lg mb-6 text-muted">{description}</p>

      <!-- Meta bar -->
      <div class="flex flex-wrap items-center gap-4 pt-5 border-t border-border">
        <span class="text-sm font-mono text-muted">{formattedDate}</span>

        {!published && (
          <span class="text-xs font-mono text-muted border border-border px-2 py-0.5 rounded">
            draft
          </span>
        )}

        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map(tag => (
              <span class="text-xs px-2 py-0.5 rounded-full font-mono bg-accent-dim text-accent border border-accent-dim2">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- MDX content -->
    <div class="prose">
      <slot />
    </div>

  </article>
</Base>
