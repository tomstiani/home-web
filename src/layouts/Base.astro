---
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Analytics from '@vercel/analytics/astro'
import { ClientRouter, fade } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  noindex?: boolean
}

const {
  title = 'tomstiani',
  description = 'I like to tinker, sometimes I write about it.',
  ogImage = '/fallback_og.png',
  noindex = false,
} = Astro.props

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).href
const pageTitle = title === 'tomstiani' ? title : `${title} — tomstiani`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicons/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32x32.png" />
    <link rel="shortcut icon" href="/assets/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/favicons/site.webmanifest" />
    <ClientRouter />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Nav />
    <main class="pt-14 flex-1" transition:animate={fade({ duration: '0.2s' })}>
      <slot />
    </main>
    <Footer />
    <Analytics />

    <div id="analytics-toast" role="status" aria-live="polite" aria-atomic="true" class="fixed bottom-5 left-5 z-50 flex items-center gap-3 px-4 py-3 rounded-lg bg-surface border border-border text-sm text-muted opacity-0 translate-y-2 transition-all duration-300 pointer-events-none">
      Basic analytics are running on this site.
      <a href="/privacy" class="text-accent hover:opacity-70 transition-opacity duration-150 shrink-0 pointer-events-auto">Learn more →</a>
      <button id="analytics-toast-close" class="ml-1 text-muted hover:text-heading transition-colors duration-150 pointer-events-auto" aria-label="Dismiss">✕</button>
    </div>
  </body>
  <script>
    function initCopyButtons() {
      document.querySelectorAll('.prose pre:not([data-copy-init])').forEach(pre => {
        if ((pre as HTMLElement).dataset.language === 'mermaid') return
        pre.setAttribute('data-copy-init', '')
        const button = document.createElement('button')
        button.textContent = 'Copy'
        button.setAttribute('aria-label', 'Copy code')
        button.className = 'copy-btn'
        pre.appendChild(button)
      })
    }

    document.addEventListener('click', async e => {
      const btn = (e.target as Element).closest('.copy-btn')
      if (!btn) return
      const code = btn.closest('pre')?.querySelector('code')?.innerText ?? ''
      await navigator.clipboard.writeText(code)
      btn.textContent = 'Copied!'
      setTimeout(() => { btn.textContent = 'Copy' }, 2000)
    })

    initCopyButtons()
    document.addEventListener('astro:page-load', initCopyButtons)

    const toast = document.getElementById('analytics-toast')
    const toastClose = document.getElementById('analytics-toast-close')

    function dismissToast() {
      if (!toast) return
      toast.style.opacity = '0'
      toast.style.transform = 'translateY(8px)'
      toast.style.pointerEvents = 'none'
      sessionStorage.setItem('analytics-toast-dismissed', '1')
    }

    const dismissed = sessionStorage.getItem('analytics-toast-dismissed')
    const shown = sessionStorage.getItem('analytics-toast-shown')

    if (toast && !dismissed) {
      if (!shown) {
        setTimeout(() => {
          toast.style.opacity = '1'
          toast.style.transform = 'translateY(0)'
          toast.style.pointerEvents = 'auto'
          sessionStorage.setItem('analytics-toast-shown', '1')
        }, 1000)
      } else {
        toast.style.opacity = '1'
        toast.style.transform = 'translateY(0)'
        toast.style.pointerEvents = 'auto'
      }
      toastClose?.addEventListener('click', dismissToast)
    }
  </script>
  <script is:inline>
  const MERMAID_THEME = {
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      background:            '#09090b',
      mainBkg:               '#0f1210',
      clusterBkg:            '#0f1210',
      secondaryColor:        '#09090b',
      tertiaryColor:         '#0f1210',
      nodeBorder:            'rgba(74,222,128,0.2)',
      clusterBorder:         'rgba(74,222,128,0.15)',
      primaryBorderColor:    'rgba(74,222,128,0.2)',
      lineColor:             'rgba(74,222,128,0.4)',
      edgeLabelBackground:   '#09090b',
      primaryTextColor:      '#e4e4e7',
      secondaryTextColor:    '#82828a',
      tertiaryTextColor:     '#82828a',
      textColor:             '#e4e4e7',
      titleColor:            '#f4f4f5',
      labelColor:            '#e4e4e7',
      primaryColor:          '#0f1210',
      fontFamily:            'Geist Mono Variable, ui-monospace, monospace',
      fontSize:              '13px',
      actorBkg:              '#0f1210',
      actorBorder:           'rgba(74,222,128,0.2)',
      actorTextColor:        '#e4e4e7',
      actorLineColor:        'rgba(74,222,128,0.3)',
      signalColor:           'rgba(74,222,128,0.6)',
      signalTextColor:       '#e4e4e7',
      labelBoxBkgColor:      '#0f1210',
      labelBoxBorderColor:   'rgba(74,222,128,0.2)',
      labelTextColor:        '#e4e4e7',
      loopTextColor:         '#e4e4e7',
      noteBorderColor:       'rgba(74,222,128,0.2)',
      noteBkgColor:          'rgba(74,222,128,0.06)',
      noteTextColor:         '#e4e4e7',
      activationBorderColor: '#4ade80',
      activationBkgColor:    'rgba(74,222,128,0.08)',
      sequenceNumberColor:   '#09090b',
    },
  }

  async function renderMermaid() {
    const fencedPres = document.querySelectorAll(
      'pre[data-language="mermaid"]:not([data-mermaid-processed])'
    )
    // .mermaid divs rendered by the explicit <Mermaid> component;
    // mermaid itself marks processed elements with data-processed
    const explicitDivs = document.querySelectorAll('.mermaid:not([data-processed])')

    if (fencedPres.length === 0 && explicitDivs.length === 0) return

    const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
    mermaid.initialize(MERMAID_THEME)

    // Convert Shiki-highlighted pre blocks into plain .mermaid divs
    fencedPres.forEach(pre => {
      pre.setAttribute('data-mermaid-processed', '')
      const code = pre.querySelector('code')
      const source = code ? code.textContent || '' : pre.textContent || ''
      const div = document.createElement('div')
      div.className = 'mermaid flex justify-center overflow-x-auto my-8'
      div.textContent = source
      pre.replaceWith(div)
    })

    // .mermaid divs (from <Mermaid> component) are passed directly to mermaid.run()
    await mermaid.run()
  }

  renderMermaid()
  document.addEventListener('astro:page-load', renderMermaid)
</script>
</html>
