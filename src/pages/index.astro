---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { getCollection } from 'astro:content'

const allProjects = await getCollection('projects')
const featured = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Base>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-6 pt-24 pb-20">
    <div class="max-w-2xl">
      <div class="flex items-center gap-2 mb-6">
        <span class="w-2 h-2 rounded-full bg-accent"></span>
        <span class="text-xs font-mono text-muted">available for interesting conversations</span>
      </div>
      <h1 class="text-5xl font-semibold tracking-tight leading-tight mb-5 text-white">
        tomstiani
      </h1>
      <p class="text-xl leading-relaxed text-muted">
        I like to tinker, sometimes I write about it.
      </p>
    </div>
  </section>

  <!-- Featured Projects -->
  {featured.length > 0 && (
    <section class="max-w-5xl mx-auto px-6 pb-24">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted">
          Featured
        </h2>
        <a
          href="/projects"
          class="text-sm text-muted transition-colors duration-150 hover:text-white"
        >
          All projects &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featured.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            date={project.data.date}
            tags={project.data.tags}
            status={project.data.status}
            cover={project.data.cover}
            href={`/projects/${project.id}`}
          />
        ))}
      </div>
    </section>
  )}
</Base>
