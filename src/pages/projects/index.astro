---
import Base from '../../layouts/Base.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
const sorted = projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Base title="Projects" description="Things I've built, tinkered with, and documented.">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-24">
    <div class="mb-12">
      <h1 class="text-3xl font-semibold tracking-tight mb-3 text-white">Projects</h1>
      <p class="text-base text-muted">
        Things I've built, tinkered with, and documented.
      </p>
    </div>

    {sorted.length === 0 ? (
      <p class="text-muted">No projects yet. Check back soon.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sorted.map(project => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            date={project.data.date}
            tags={project.data.tags}
            status={project.data.status}
            cover={project.data.cover}
            href={`/projects/${project.id}`}
          />
        ))}
      </div>
    )}
  </section>
</Base>
