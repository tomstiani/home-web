---
import Base from '../../layouts/Base.astro'
import ThoughtCard from '../../components/ThoughtCard.astro'
import { getCollection } from 'astro:content'

const thoughts = await getCollection('thoughts')
const publishedThoughts = thoughts
  .filter(t => t.data.published)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Base title="Thoughts" description="Opinions, observations, and things I keep thinking about.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-24">
    <div class="mb-12">
      <h1 class="text-3xl font-semibold tracking-tight mb-3 text-heading">Thoughts</h1>
      <p class="text-base text-muted">
        Opinions, observations, and things I keep thinking about.
      </p>
    </div>

    {publishedThoughts.length === 0 ? (
      <p class="text-muted">Nothing here yet. Check back soon.</p>
    ) : (
      <div class="border-t border-border">
        {publishedThoughts.map(thought => (
          <ThoughtCard
            title={thought.data.title}
            description={thought.data.description}
            date={thought.data.date}
            tags={thought.data.tags}
            href={`/thoughts/${thought.id}`}
          />
        ))}
      </div>
    )}
  </section>
</Base>
