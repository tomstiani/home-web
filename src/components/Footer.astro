---
import { Icon } from 'astro-icon/components'

const year = new Date().getFullYear()

const socials: { label: string; href: string; icon: string }[] = [
  { label: 'GitHub', href: 'https://github.com/tomstiani', icon: 'simple-icons:github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/tomstiani/', icon: 'simple-icons:linkedin' },
]
---

<footer class="border-t border-border mt-24">
  <div class="max-w-5xl mx-auto px-6 py-8 flex items-center justify-between">
    <span class="text-sm text-muted">
      &copy; {year} tomstiani
    </span>
    <ul class="flex items-center gap-4 list-none m-0 p-0">
      {socials.map(s => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="inline-flex items-center justify-center w-11 h-11 text-muted transition-colors duration-150 hover:text-heading"
          >
            <Icon name={s.icon} class="w-5 h-5" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
