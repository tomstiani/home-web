---
const year = new Date().getFullYear()

// Social links — add yours here when ready
const socials: { label: string; href: string }[] = [
  // { label: 'GitHub', href: 'https://github.com/yourhandle' },
  // { label: 'X', href: 'https://x.com/yourhandle' },
]
---

<footer class="border-t border-border mt-24">
  <div class="max-w-5xl mx-auto px-6 py-8 flex items-center justify-between">
    <span class="text-sm text-muted">
      &copy; {year} tomstiani
    </span>
    {socials.length > 0 && (
      <ul class="flex items-center gap-5 list-none m-0 p-0">
        {socials.map(s => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted transition-colors duration-150 hover:text-white"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</footer>
