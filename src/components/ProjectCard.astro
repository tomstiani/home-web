---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  description: string
  date: Date
  tags: string[]
  status: 'completed' | 'ongoing'
  href: string
  cover?: ImageMetadata
}

const { title, description, date, tags, status, href, cover } = Astro.props

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
})
---

<a
  href={href}
  class="group flex flex-col rounded-lg bg-surface border border-border transition-colors duration-150 hover:border-accent-hover overflow-hidden"
>
  <!-- Cover image — fixed height, no padding so it bleeds to edges -->
  {cover && (
    <Image
      src={cover}
      alt={title}
      width={600}
      height={160}
      class="w-full h-40 object-cover border-b border-border"
    />
  )}

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-start justify-between gap-4 mb-2">
      <h3 class="text-base font-semibold leading-snug text-white line-clamp-2">
        {title}
      </h3>
      {status === 'ongoing' && (
        <span class="flex items-center gap-1.5 shrink-0 text-xs font-medium text-accent">
          <span class="w-1.5 h-1.5 rounded-full inline-block bg-accent"></span>
          Ongoing
        </span>
      )}
    </div>

    <p class="text-sm leading-relaxed text-muted line-clamp-3 mb-4">
      {description}
    </p>

    <!-- Tags + date pinned to bottom -->
    <div class="mt-auto flex items-end justify-between gap-3">
      <div class="flex flex-wrap gap-1.5">
        {tags.map(tag => (
          <span class="text-xs px-2 py-0.5 rounded-full font-mono bg-accent-dim text-accent border border-accent-dim2">
            {tag}
          </span>
        ))}
      </div>
      <span class="text-xs shrink-0 text-muted">{formattedDate}</span>
    </div>
  </div>
</a>
