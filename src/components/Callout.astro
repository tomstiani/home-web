---
interface Props {
  type?: 'note' | 'warning' | 'tip' | 'disclaimer'
}

const { type = 'note' } = Astro.props

const config = {
  note: {
    label: 'Note',
    borderColor: 'border-l-accent',
    bgColor: 'bg-accent-dim',
    labelColor: 'text-accent',
  },
  warning: {
    label: 'Warning',
    borderColor: 'border-l-[#fbbf24]',
    bgColor: 'bg-[rgba(251,191,36,0.06)]',
    labelColor: 'text-[#fbbf24]',
  },
  tip: {
    label: 'Tip',
    borderColor: 'border-l-[#38bdf8]',
    bgColor: 'bg-[rgba(56,189,248,0.06)]',
    labelColor: 'text-[#38bdf8]',
  },
  disclaimer: {
    label: 'Disclaimer',
    borderColor: 'border-l-[#71717a]',
    bgColor: 'bg-[rgba(113,113,122,0.06)]',
    labelColor: 'text-muted',
  },
} satisfies Record<string, { label: string; borderColor: string; bgColor: string; labelColor: string }>

const { label, borderColor, bgColor, labelColor } = config[type]
---

<aside class={`border-l-2 pl-4 py-3 pr-4 my-6 rounded-r-md ${borderColor} ${bgColor}`}>
  <p class={`text-xs font-semibold font-mono uppercase tracking-wider mb-1.5 ${labelColor}`}>{label}</p>
  <div class="text-text text-sm leading-relaxed [&>p]:mb-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</aside>
