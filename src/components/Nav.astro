---
const links = [
  { label: 'Projects', href: '/projects' },
  { label: 'Contact', href: '/contact' },
]

const pathname = Astro.url.pathname
---

<header transition:persist transition:animate="none" class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-nav-bg backdrop-blur-md">
  <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="text-sm font-semibold tracking-tight text-white flex items-center">
      <span class="text-accent">//</span>tomstiani
    </a>
    <ul class="flex items-center gap-6 list-none m-0 p-0">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class={`text-sm transition-colors duration-150 ${pathname.startsWith(link.href) ? 'text-accent' : 'text-muted'}`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
